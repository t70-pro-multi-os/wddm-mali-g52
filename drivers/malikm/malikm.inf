;
; malikm.inf - milestone M3: the Mali kernel driver Mesa's Panfrost talks to
; through \\.\MaliG52 (the name is kept for the libdrm shim). This mt6789
; branch builds it for the Mali-G57 MC2 of the MediaTek MT6789 and binds
; ACPI\HANA678E, GPU0 in the Mu-Silicium T70 Pro DSDT, which is present only
; when the firmware powered the GPU and read its GPU_ID back. maliwddm binds
; the same device: install one of the two. (Upstream's RK3576 build binds
; ACPI\RKCP7402.)
;
; SPDX-License-Identifier: GPL-2.0
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
DriverVer   = ; set by stampinf during build
CatalogFile = malikm.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
malikm.sys = 1

[Manufacturer]
%ProviderName% = Standard,NTARM64.10.0...16299

[Standard.NTARM64.10.0...16299]
%MK.DeviceDesc% = MK_Inst,ACPI\HANA678E

[MK_Inst.NT]
CopyFiles = MK_CopyFiles

[MK_CopyFiles]
malikm.sys

[MK_Inst.NT.Services]
AddService = malikm,0x00000002,MK_Service

[MK_Service]
DisplayName   = %MK.SvcDesc%
ServiceType   = 1 ; SERVICE_KERNEL_DRIVER
StartType     = 3 ; SERVICE_DEMAND_START
ErrorControl  = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\malikm.sys

[MK_Inst.NT.Wdf]
KmdfService = malikm, MK_wdfsect

[MK_wdfsect]
KmdfLibraryVersion = 1.33

[Strings]
ProviderName  = "wddm-mali-g52"
DiskName      = "Mali-G52 kernel driver"
MK.DeviceDesc = "Arm Mali-G57 MC2 (Panfrost uAPI)"
MK.SvcDesc    = "Arm Mali-G52 kernel driver"
