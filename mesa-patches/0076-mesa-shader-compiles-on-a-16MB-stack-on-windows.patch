@@ -17,6 +17,49 @@
 #include "pan_context.h"
 #include "pan_compiler.h"
 #include "pan_nir.h"
+#include "c11/threads.h"
+
+/*
+ * Shader creation and compilation on a thread of their own on Windows. The
+ * D3D10 UMD runs in the caller's threads, and dwm.exe reserves only 512 KiB
+ * of stack per thread: NIR lowering plus the Valhall compiler overran it
+ * (stack overflow 0xc00000fd in dwm.exe as soon as the Start menu asked for
+ * new shaders). thrd_create reserves 16 MiB (c11 threads_win32.c); the
+ * caller waits, so nothing else changes.
+ */
+#ifdef _WIN32
+struct pan_big_stack_call {
+   void (*fn)(void *);
+   void *arg;
+};
+
+static int
+pan_big_stack_thunk(void *p)
+{
+   struct pan_big_stack_call *c = p;
+   c->fn(c->arg);
+   return 0;
+}
+
+static void
+pan_on_big_stack(void (*fn)(void *), void *arg)
+{
+   struct pan_big_stack_call c = { fn, arg };
+   thrd_t t;
+
+   if (thrd_create(&t, pan_big_stack_thunk, &c) != thrd_success) {
+      fn(arg);
+      return;
+   }
+   thrd_join(t, NULL);
+}
+#else
+static void
+pan_on_big_stack(void (*fn)(void *), void *arg)
+{
+   fn(arg);
+}
+#endif
 #include "pan_trace.h"
 #include "compiler/bifrost/bifrost_compile.h"
 #include "shader_enums.h"
